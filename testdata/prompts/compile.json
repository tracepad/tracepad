{
  "about": "Prompt.compile cases the Python, Node and Go packages all run (spec 017 #18). A case compiles `text` or `messages` with `variables`, all of them strings, and either equals `compiled` or raises an error containing `error`. `go` is what the Go package gives instead where it differs: it never raises, leaves a placeholder no variable names as it is, and keeps a message's role and content only.",
  "cases": [
    { "name": "a placeholder", "text": "Answer {q}.", "variables": {"q": "hi"}, "compiled": "Answer hi." },
    { "name": "a variable named self", "text": "{self} and {q}", "variables": {"self": "me", "q": "hi"}, "compiled": "me and hi" },
    { "name": "the same placeholder twice", "text": "{q}, {q}", "variables": {"q": "hi"}, "compiled": "hi, hi" },
    { "name": "a variable the text does not use", "text": "plain", "variables": {"q": "hi"}, "compiled": "plain" },
    { "name": "an empty text", "text": "", "variables": {}, "compiled": "" },
    { "name": "doubled braces", "text": "{{lit}}", "variables": {}, "compiled": "{lit}" },
    { "name": "a JSON example", "text": "Reply as {{\"answer\": \"{q}\"}}.", "variables": {"q": "yes"}, "compiled": "Reply as {\"answer\": \"yes\"}." },
    { "name": "a placeholder inside doubled braces", "text": "{{{q}}}", "variables": {"q": "hi"}, "compiled": "{hi}" },
    { "name": "a value with braces is not read again", "text": "{q}", "variables": {"q": "{r}"}, "compiled": "{r}" },
    { "name": "a format spec", "text": "[{q:>12}]", "variables": {"q": "hi"}, "error": "prompt placeholder {q:>12} has no variable", "go": {"compiled": "[{q:>12}]"} },
    { "name": "a width that would allocate", "text": "{q:>50000000}", "variables": {"q": "hi"}, "error": "prompt placeholder {q:>50000000} has no variable", "go": {"compiled": "{q:>50000000}"} },
    { "name": "an attribute", "text": "{n.real}", "variables": {"n": "5"}, "error": "prompt placeholder {n.real} has no variable", "go": {"compiled": "{n.real}"} },
    { "name": "an index", "text": "{a[0]}", "variables": {"a": "x"}, "error": "prompt placeholder {a[0]} has no variable", "go": {"compiled": "{a[0]}"} },
    { "name": "a conversion", "text": "{x!r}", "variables": {"x": "hi"}, "error": "prompt placeholder {x!r} has no variable", "go": {"compiled": "{x!r}"} },
    { "name": "a name with spaces", "text": "{ q }", "variables": {"q": "hi"}, "error": "prompt placeholder { q } has no variable", "go": {"compiled": "{ q }"} },
    { "name": "an unknown name", "text": "Answer {missing}.", "variables": {"q": "hi"}, "error": "prompt placeholder {missing} has no variable", "go": {"compiled": "Answer {missing}."} },
    { "name": "empty braces", "text": "{}", "variables": {"q": "hi"}, "error": "prompt placeholder {} has no variable", "go": {"compiled": "{}"} },
    { "name": "an opening brace never closed", "text": "{q", "variables": {"q": "hi"}, "compiled": "{q" },
    { "name": "a closing brace never opened", "text": "q}", "variables": {"q": "hi"}, "compiled": "q}" },
    { "name": "braces the wrong way round", "text": "}{q}{", "variables": {"q": "hi"}, "compiled": "}hi{" },
    { "name": "a brace inside a placeholder", "text": "{a{q}", "variables": {"q": "hi"}, "compiled": "{ahi", "go": {"compiled": "{a{q}"} },
    {
      "name": "every message, keeping the other fields",
      "messages": [
        {
          "role": "system",
          "content": "You help with {product}. Reply as {{\"ok\": true}}.",
          "name": "rules"
        },
        {
          "role": "user",
          "content": "{question}"
        },
        {
          "role": "assistant",
          "content": ""
        }
      ],
      "variables": {
        "product": "Tracepad",
        "question": "why?"
      },
      "compiled": [
        {
          "role": "system",
          "content": "You help with Tracepad. Reply as {\"ok\": true}.",
          "name": "rules"
        },
        {
          "role": "user",
          "content": "why?"
        },
        {
          "role": "assistant",
          "content": ""
        }
      ],
      "go": {
        "note": "Go's Message carries role and content only: the other fields, `name` here, are dropped.",
        "compiled": [
          { "role": "system", "content": "You help with Tracepad. Reply as {\"ok\": true}." },
          { "role": "user", "content": "why?" },
          { "role": "assistant", "content": "" }
        ]
      }
    },
    {
      "name": "a format spec in a later message",
      "messages": [
        {
          "role": "system",
          "content": "You help with {product}."
        },
        {
          "role": "user",
          "content": "{question:>12}"
        }
      ],
      "variables": {
        "product": "Tracepad",
        "question": "why?"
      },
      "error": "prompt placeholder {question:>12} has no variable",
      "go": {
        "compiled": [
          {
            "role": "system",
            "content": "You help with Tracepad."
          },
          {
            "role": "user",
            "content": "{question:>12}"
          }
        ]
      }
    }
  ]
}
