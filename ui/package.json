{
  "name": "tracepad-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "test": "vitest run",
    "types": "openapi-typescript ../internal/server/openapi.json -o src/lib/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "~24.13.6",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "1.2.4",
    "@lucide/svelte": "^1.49.0",
    "bits-ui": "^2.19.4",
    "svelte-dnd-action": "^0.9.79",
    "uplot": "^1.6.32"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  }
}
