{
  "name": "tracepad",
  "version": "0.1.0",
  "description": "The Node package for Tracepad: a thin layer of ergonomics over the OpenTelemetry SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tracepad/tracepad.git",
    "directory": "sdk/js"
  },
  "homepage": "https://github.com/tracepad/tracepad/blob/main/docs/sdk-js.md",
  "keywords": [
    "opentelemetry",
    "otlp",
    "llm",
    "observability",
    "tracing",
    "evals"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^22.20.2",
    "sdk-trace-base-v1": "npm:@opentelemetry/sdk-trace-base@^1.30.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
